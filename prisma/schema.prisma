/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model b2b_credit_profiles {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String    @unique
  tier                  String
  credit_limit          Decimal?  @default(0) @db.Decimal
  credit_balance        Decimal?  @default(0) @db.Decimal
  credit_days_remaining Int?      @default(0)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "idx_b2b_credit_profiles_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model business_applications {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_user_id   String
  applicant_name  String
  applicant_email String
  business_name   String
  business_type   String
  nit             String?   @default("")
  phone           String
  address         String
  municipality    String
  monthly_volume  String?   @default("")
  notes           String?   @default("")
  status          String    @default("pending")
  reviewed_by     String?
  reviewed_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([clerk_user_id], map: "idx_applications_clerk_user")
  @@index([created_at(sort: Desc)], map: "idx_applications_created")
  @@index([status], map: "idx_applications_status")
}

