# Copy to .env.local and configure this project’s Clerk and Supabase credentials.
# Never commit .env.local or paste secret keys into source files.

# Clerk: the existing authentication and customer portals
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase: catalog and owned data; service key is SERVER ONLY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Wompi: optional until online payment setup is complete
NEXT_PUBLIC_WOMPI_PUB_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Required only when enabling scheduled marketing jobs
CRON_SECRET=

# Public customer-support destinations
# In staging: use synthetic address. Operational production inbox to be confirmed by Eduard Velazco.
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@staging.lagaviotafruver.com
NEXT_PUBLIC_WHATSAPP_NUMBER=573184990826

