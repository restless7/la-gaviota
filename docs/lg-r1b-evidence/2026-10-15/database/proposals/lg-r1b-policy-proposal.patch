+DO $$ BEGIN IF current_setting('lg_r1b.review_gate',true) IS DISTINCT FROM 'SYNTHETIC_OR_REVIEWED_METADATA_ONLY' THEN RAISE EXCEPTION 'LG-R1B reviewed metadata/client transition gate missing'; END IF; END $$;
+DO $$ DECLARE x record; BEGIN FOR x IN SELECT schemaname,tablename,policyname FROM pg_policies WHERE (schemaname='public' AND tablename=ANY(ARRAY['abandoned_carts','agricultural_shrinkage_logs','audit_logs','b2b_credit_profiles','business_applications','buying_templates','customers','daily_operational_ledgers','global_settings','kit_items','kits','marketing_leads','order_items','orders','products','suppliers','system_settings'])) OR (schemaname='storage' AND tablename='objects') LOOP IF x.policyname <> ALL(ARRAY['Admins can read all audit logs','Admins full access b2b_credit_profiles','Allow admin full access to abandoned carts','Allow admin full access to audit logs','Allow admin full access to kit items','Allow admin full access to kits','Allow admin full access to marketing leads','Allow admin insert to kit-banners','Allow admin insert to product-images','Allow admin update to kit-banners','Allow admin update to product-images','Allow log insertion','Allow public all on suppliers','Allow public inserts on abandoned carts','Allow public inserts on customers','Allow public inserts on marketing leads','Allow public inserts on order_items','Allow public inserts on orders','Allow public inserts on products','Allow public read access to active kits','Allow public read access to kit items','Allow public read access to kit-banners','Allow public read access to product-images','Allow public reads on customers','Allow public reads on global_settings','Allow public reads on order_items','Allow public reads on orders','Allow public reads on products','Allow public reads on suppliers','Allow public updates on customers','Allow public updates on orders','Allow public updates on own abandoned carts','Allow public updates on products','Allow select for all','Allow update for authenticated','Allow updates on global_settings','Ledgers son visibles para todos','Shrinkage insert access','Shrinkage read access','Solo admins/autenticados pueden insertar ledgers','Users can manage own templates','Users can read own credit profile','Users can read own templates','fixture_legacy_public_all']) THEN RAISE EXCEPTION 'Unreviewed policy %.%/%: abort', x.schemaname,x.tablename,x.policyname; END IF; END LOOP; END $$;
+DO $$ BEGIN IF EXISTS (SELECT 1 FROM pg_auth_members WHERE member IN ('anon'::regrole,'authenticated'::regrole)) THEN RAISE EXCEPTION 'Inherited role grants need independent review'; END IF; END $$;
+REVOKE CREATE ON SCHEMA public FROM PUBLIC,anon,authenticated;
+CREATE SCHEMA IF NOT EXISTS lg_private; REVOKE ALL ON SCHEMA lg_private FROM PUBLIC,anon,authenticated;
+-- No identity registry; helper reads only native gateway-provided Clerk subject and transport role.
+CREATE OR REPLACE FUNCTION lg_private.clerk_subject() RETURNS text LANGUAGE sql STABLE SECURITY INVOKER SET search_path = '' AS $$ SELECT CASE WHEN (auth.jwt()->>'role') = 'authenticated' AND (auth.jwt()->>'sub') ~ '^user_[A-Za-z0-9_]+$' THEN auth.jwt()->>'sub' ELSE NULL END $$;
+REVOKE ALL ON FUNCTION lg_private.clerk_subject() FROM PUBLIC; GRANT USAGE ON SCHEMA lg_private TO authenticated; GRANT EXECUTE ON FUNCTION lg_private.clerk_subject() TO authenticated;
+DO $$ DECLARE x record; BEGIN FOR x IN SELECT schemaname,tablename,policyname FROM pg_policies WHERE schemaname='public' AND tablename=ANY(ARRAY['abandoned_carts','agricultural_shrinkage_logs','audit_logs','b2b_credit_profiles','business_applications','buying_templates','customers','daily_operational_ledgers','global_settings','kit_items','kits','marketing_leads','order_items','orders','products','suppliers','system_settings']) LOOP EXECUTE format('DROP POLICY %I ON %I.%I',x.policyname,x.schemaname,x.tablename); END LOOP; END $$;
