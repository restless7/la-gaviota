+CREATE POLICY lg_products_public_read ON public.products FOR SELECT TO anon,authenticated USING (is_active IS TRUE);
+CREATE OR REPLACE VIEW public.catalog_public WITH (security_invoker=true,security_barrier=true) AS SELECT id,name,category,subcategory,unit,price_retail,previous_price_retail,stock_quantity,is_active,is_in_season,image_url,description FROM public.products WHERE is_active IS TRUE;
