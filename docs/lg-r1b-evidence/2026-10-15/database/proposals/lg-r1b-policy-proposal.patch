+GRANT SELECT (id,clerk_user_id,customer_name,customer_email,customer_phone,delivery_address,delivery_municipality,total_amount,status,payment_method,notes,created_at,scheduled_delivery_date,purchase_tier) ON public.orders TO authenticated;
+CREATE POLICY lg_orders_owner_read ON public.orders FOR SELECT TO authenticated USING (clerk_user_id=(SELECT lg_private.clerk_subject()));
+GRANT SELECT (id,user_id,tier,credit_limit,credit_balance,credit_days_remaining,updated_at) ON public.b2b_credit_profiles TO authenticated;
