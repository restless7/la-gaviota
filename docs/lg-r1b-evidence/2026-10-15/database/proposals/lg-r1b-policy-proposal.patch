+GRANT SELECT (id,order_id,product_id,product_name,quantity,price_at_purchase,created_at) ON public.order_items TO authenticated;
+CREATE POLICY lg_order_items_owner_read ON public.order_items FOR SELECT TO authenticated USING (EXISTS (SELECT 1 FROM public.orders o WHERE o.id=order_items.order_id AND o.clerk_user_id=(SELECT lg_private.clerk_subject())));
+CREATE INDEX IF NOT EXISTS lg_orders_owner_idx ON public.orders(clerk_user_id);
+CREATE INDEX IF NOT EXISTS lg_order_items_order_idx ON public.order_items(order_id);
+-- No direct owner INSERT/UPDATE/DELETE: guarded server writers preserve statuses/credit/ownership.
+-- No staff/admin JWT policy; app role/tier claims never turn user JWT into a privileged DB credential.
+-- Existing service_role grants preserved; effective privileges/bypass MUST be attested before deployment.
+DO $$ BEGIN IF to_regprocedure('storage.allow_any_operation(text[])') IS NULL THEN RAISE EXCEPTION 'Storage operation helper missing; reconcile installed API before applying'; END IF; END $$;
+-- Public buckets keep normal public URL delivery; row access below is operation-aware, not unrestricted listing.
+DO $$ DECLARE x record; BEGIN FOR x IN SELECT policyname FROM pg_policies WHERE schemaname='storage' AND tablename='objects' LOOP EXECUTE format('DROP POLICY %I ON storage.objects',x.policyname); END LOOP; END $$;
+REVOKE ALL ON TABLE storage.objects FROM PUBLIC,anon,authenticated;
+DO $$ DECLARE cols text; BEGIN SELECT string_agg(quote_ident(attname),',') INTO cols FROM pg_attribute WHERE attrelid='storage.objects'::regclass AND attnum>0 AND NOT attisdropped; EXECUTE format('REVOKE SELECT (%s), INSERT (%s), UPDATE (%s), REFERENCES (%s) ON TABLE storage.objects FROM PUBLIC,anon,authenticated',cols,cols,cols,cols); END $$;
+GRANT SELECT ON storage.objects TO anon,authenticated;
+CREATE POLICY lg_media_public_read ON storage.objects FOR SELECT TO anon,authenticated USING (bucket_id IN ('product-images','kit-banners') AND storage.allow_any_operation(ARRAY['object.get_authenticated_info','object.get_authenticated']));
+-- No public/user storage DML policies/grants. Admin upload/update/delete uses fresh guard then server-only service client.
+-- Public bucket bytes intentionally remain public; private buckets NOT exposed by this proposal.
+REVOKE ALL ON TABLE storage.buckets FROM PUBLIC,anon,authenticated;
+DO $$ DECLARE cols text; BEGIN SELECT string_agg(quote_ident(attname),',') INTO cols FROM pg_attribute WHERE attrelid='storage.buckets'::regclass AND attnum>0 AND NOT attisdropped; EXECUTE format('REVOKE SELECT (%s), INSERT (%s), UPDATE (%s), REFERENCES (%s) ON TABLE storage.buckets FROM PUBLIC,anon,authenticated',cols,cols,cols,cols); END $$;
+COMMIT;
