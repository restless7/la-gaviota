diff --git a/src/lib/cartPersistence.ts b/src/lib/cartPersistence.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/cartPersistence.ts
@@ -0,0 +1,30 @@
+import type { Product } from '@/src/actions/products';
+export interface CartDraft { version: 2; items: { id: string; quantity: number }[] }
+export function parseCartDraft(raw: string): CartDraft {
+  if (raw.length > 1048576) throw new Error('CART_RESTORE_OVERSIZED');
+  const value: unknown = JSON.parse(raw);
+  const rows = Array.isArray(value) ? value : value && typeof value === 'object' && 'version' in value && value.version === 2 && 'items' in value ? value.items : null;
+  if (!Array.isArray(rows) || rows.length > 300) throw new Error('CART_RESTORE_INVALID');
+  const items: CartDraft['items'] = [];
+  for (const row of rows) {
+    if (!row || typeof row !== 'object') throw new Error('CART_RESTORE_INVALID');
+    const record = row as Record<string, unknown>;
+    const product = record.product;
+    const id = typeof record.id === 'string' ? record.id : product && typeof product === 'object' && 'id' in product ? product.id : null;
+    const quantity = record.quantity;
+    if (typeof id !== 'string' || !/^[A-Za-z0-9_-]{1,128}$/.test(id) || typeof quantity !== 'number' || !Number.isFinite(quantity) || quantity <= 0 || quantity > 1000000) throw new Error('CART_RESTORE_INVALID');
+    if (items.some(item => item.id === id)) throw new Error('CART_RESTORE_DUPLICATE');
+    items.push({ id, quantity });
+  }
+  return { version: 2, items };
+}
+export function reconcileCartDraft(draft: CartDraft, catalog: Product[], now: number) {
+  const items: { product: Product; quantity: number; addedAt: number }[] = [];
+  const rejected: string[] = [];
+  for (const line of draft.items) {
+    const product = catalog.find(p => p.id === line.id);
+    if (!product || !product.isActive || !Number.isFinite(product.price) || product.price < 0) { rejected.push(line.id); continue; }
+    items.push({ product, quantity: line.quantity, addedAt: now });
+  }
+  return { items, rejected };
+}
diff --git a/src/lib/server/authorization.ts b/src/lib/server/authorization.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/server/authorization.ts
@@ -0,0 +1,33 @@
+import 'server-only';
+import { auth, clerkClient } from '@clerk/nextjs/server';
+export type Role = 'GUEST' | 'USER' | 'ADMIN' | 'SUPER_ADMIN' | 'OPERARIO' | 'COMMERCIAL' | 'INVALID';
+export type Tier = 'Personas Naturales' | 'Micromercados' | 'Restaurantes';
+export type Capability = 'identity.read' | 'identity.manage' | 'catalog.manage' | 'pricing.manage' | 'inventory.manage' | 'customers.manage' | 'tiers.manage' | 'orders.manage' | 'payments.manage' | 'reports.read' | 'audit.read' | 'settings.read' | 'settings.manage' | 'suppliers.manage' | 'storage.manage' | 'audit.write';
+export interface Actor { readonly userId: string | null; readonly role: Role; readonly tier: Tier }
+const issued = new WeakSet<object>();
+const staff: Capability[] = ['catalog.manage','pricing.manage','inventory.manage','customers.manage','tiers.manage','orders.manage','payments.manage','reports.read','settings.read','settings.manage','suppliers.manage','storage.manage','audit.write'];
+const knownCapabilities: Capability[] = [...staff, 'identity.read', 'identity.manage', 'audit.read'];
+const tiers: Tier[] = ['Personas Naturales','Micromercados','Restaurantes'];
+export function assertTargetId(value: unknown): asserts value is string { if (typeof value !== 'string' || !/^[A-Za-z0-9_-]{1,128}$/.test(value)) throw new Error('INVALID_TARGET'); }
+export function validateTier(value: unknown): Tier { if (!tiers.includes(value as Tier)) throw new Error('INVALID_TIER'); return value as Tier; }
+export function validateRole(value: unknown): Exclude<Role,'GUEST'|'INVALID'> { if (!['USER','ADMIN','SUPER_ADMIN','OPERARIO','COMMERCIAL'].includes(value as string)) throw new Error('INVALID_ROLE'); return value as Exclude<Role,'GUEST'|'INVALID'>; }
+export async function getActor(): Promise<Actor> {
+ const { userId } = await auth();
+ if (!userId) { const guest: Actor = Object.freeze({userId:null,role:'GUEST',tier:'Personas Naturales'}); issued.add(guest); return guest; }
+ assertTargetId(userId);
+ const user = await (await clerkClient()).users.getUser(userId);
+ if (!user || user.id !== userId || user.banned || user.locked) throw new Error('INVALID_ACTOR');
+ const meta = user.publicMetadata || {};
+ const raw = meta.role;
+ const role: Role = raw == null || raw === 'USER' || raw === 'CLIENT' ? 'USER' : ['ADMIN','SUPER_ADMIN','OPERARIO','COMMERCIAL'].includes(raw as string) ? raw as Role : 'INVALID';
+ // Tier is never a source of privileged role elevation. Unknown pricing tier is retail.
+ const tier: Tier = role !== 'INVALID' && tiers.includes(meta.tier as Tier) ? meta.tier as Tier : 'Personas Naturales';
+ const actor: Actor = Object.freeze({ userId, role, tier }); issued.add(actor); return actor;
+}
+export function assertIssuedActor(actor: Actor): void { if (!issued.has(actor) || !actor.userId || actor.role === 'INVALID') throw new Error('INVALID_ACTOR'); }
+export function hasCapability(actor: Actor, capability: Capability): boolean {
+ if (!issued.has(actor) || !knownCapabilities.includes(capability)) return false;
+ return actor.role === 'SUPER_ADMIN' || actor.role === 'ADMIN' && staff.includes(capability);
+}
+export async function requireCapability(capability: Capability): Promise<Actor> { const actor = await getActor(); if (!hasCapability(actor, capability)) throw new Error('FORBIDDEN'); return actor; }
+export async function requireOwnedSubject(subject: unknown): Promise<Actor> { const actor = await getActor(); assertIssuedActor(actor); assertTargetId(subject); if (subject !== actor.userId && !hasCapability(actor,'customers.manage')) throw new Error('FORBIDDEN_OWNER'); return actor; }
diff --git a/src/lib/server/database.ts b/src/lib/server/database.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/server/database.ts
@@ -0,0 +1,39 @@
+import { requireScheduler } from './scheduler';
+import 'server-only';
+import { createClient } from '@supabase/supabase-js';
+import { assertIssuedActor, type Actor } from './authorization';
+// Service role bypasses RLS: guards and scoped queries are the trusted boundary.
+// No anonymous-key fallback. Secret is read only after a validated actor is supplied.
+export function getServerDatabase(actor: Actor) {
+ assertIssuedActor(actor);
+ const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+ const key = process.env.SUPABASE_SERVICE_ROLE_KEY;
+ if (!url || !key) throw new Error('SERVER_DATABASE_UNCONFIGURED');
+ return createClient(url,key,{auth:{persistSession:false,autoRefreshToken:false}});
+}
+
+// Scheduler credentials are considered a capability only after constant-time verification.
+export function getSchedulerDatabase(req: Request) {
+ requireScheduler(req);
+ return configuredServiceDatabase();
+}
+function configuredServiceDatabase() {
+ const url=process.env.NEXT_PUBLIC_SUPABASE_URL, key=process.env.SUPABASE_SERVICE_ROLE_KEY;
+ if(!url || !key) throw new Error('SERVER_DATABASE_UNCONFIGURED');
+ return createClient(url,key,{auth:{persistSession:false,autoRefreshToken:false}});
+}
+// Intentionally public insertion boundary; validation and fixed projection occur before credentials.
+export async function insertPublicLead(payload: Record<string,unknown>) {
+ const allowed=['fullName','businessName','businessType','phone','email','source'];
+ if(Object.keys(payload).some(k=>!allowed.includes(k)) || Object.values(payload).some(v=>typeof v!=='string'||v.length>512) || !payload.fullName || !payload.phone || !payload.businessType) throw new Error('INVALID_LEAD');
+ const db=configuredServiceDatabase();
+ return db.from('marketing_leads').insert({full_name:payload.fullName,business_name:payload.businessName,business_type:payload.businessType,phone:payload.phone,email:payload.email,source:payload.source||'Landing Page',status:'Nuevo'}).select('id').single();
+}
+
+// Public fixed projection; no caller-supplied table or select and no fail-open false.
+export async function readPublicInventoryFlag() {
+ const db=configuredServiceDatabase();
+ const {data,error}=await db.from('global_settings').select('track_inventory').eq('id','default').single();
+ if(error || !data || typeof data.track_inventory!=='boolean') throw new Error('INVENTORY_SETTING_UNAVAILABLE');
+ return {track_inventory:data.track_inventory};
+}
diff --git a/src/lib/server/orderWriter.ts b/src/lib/server/orderWriter.ts
new file mode 100644
